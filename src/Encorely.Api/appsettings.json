{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.AspNetCore.SignalR": "Warning",
      "Microsoft.AspNetCore.Http.Connections": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Port": 5432,
    "SslMode": "Prefer",
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "encorely-api",
    "Audience": "encorely-app",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Matching": {
    "RadarMinSwipes": 15,
    "RadarMinAffinity": 0
  },
  "RateLimit": {
    "AuthPermitPerMinute": 10,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15
  },
  "Seed": {
    "Catalog": false
  },
  "Push": {
    "Enabled": false
  },
  "Legal": {
    "ConsentVersion": "2026-10-13",
    "EffectiveDate": "2026-10-13"
  },
  "Spotify": {
    "AllowedRedirects": "encorely://spotify-callback"
  }
}

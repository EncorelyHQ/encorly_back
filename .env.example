# Copia a .env y completa. Ningún valor tiene respaldo en el código: si falta un obligatorio, la API no arranca.

# --- Postgres (obligatorio) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=encorely
DB_USER=encorely
DB_PASSWORD=            # elige una; docker compose la usa para crear la BD
# Disable | Allow | Prefer | Require | VerifyCA | VerifyFull (local: Prefer; producción: Require o VerifyFull)
DB_SSL_MODE=Prefer
# true en local/demo; en producción corre las migraciones como paso de despliegue
DB_MIGRATE_ON_STARTUP=true

# --- JWT (obligatorio) ---
# Mínimo 32 caracteres aleatorios. Genera uno con: openssl rand -base64 48
JWT_SIGNING_KEY=
JWT_ISSUER=encorely-api
JWT_AUDIENCE=encorely-app
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# --- Seed ---
# Inserta géneros, canciones (previews de iTunes) y eventos curados si faltan
SEED_CATALOG=true
# Si tiene valor, crea los usuarios demo (lista en src/Encorely.Api/Data/Seed/demo-users.json) con esta contraseña.
# Déjalo vacío en producción.
DEMO_USER_PASSWORD=

# --- Reglas del radar ---
RADAR_MIN_SWIPES=15
RADAR_MIN_AFFINITY=0

# --- Abuso ---
# Escrituras por usuario y minuto (likes, mensajes, reportes, swipes…)
RATE_LIMIT_USER_WRITES_PER_MINUTE=120

# --- Chat ---
# Días que el servidor guarda un mensaje cifrado (0 = sin límite; usa 30 cuando la app tenga historial local + ack)
CHAT_MESSAGE_RETENTION_DAYS=0

# --- Push (Expo Push API → FCM/APNs). Opcional ---
PUSH_ENABLED=false
EXPO_PUSH_ACCESS_TOKEN=

# --- Web ---
# Orígenes CORS separados por coma (solo si usas Expo web)
CORS_ORIGINS=
# URL pública de la API (enlaces de términos y borrado de cuenta)
PUBLIC_BASE_URL=http://localhost:5000
